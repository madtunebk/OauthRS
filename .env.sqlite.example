# OauthRS — SQLite standalone mode (no PostgreSQL or Redis needed)
# Copy to .env and replace every placeholder.

STORAGE_BACKEND=sqlite
# Database file; created and migrated on first start
SQLITE_PATH=oauthrs.db

JWT_SECRET=CHANGE_ME_long_random_string
JWT_EXPIRY_SECS=3600
ADMIN_SECRET=CHANGE_ME_admin_secret

HOST=127.0.0.1
PORT=8080

INVITE_REQUIRED=true
INVITE_TTL_SECS=86400

# Set to false only when serving over plain HTTP (development)
COOKIE_SECURE=true

# Directory containing the *.tpl templates
TEMPLATES_DIR=src/core/templates

# Google OAuth (optional — leave empty to disable)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://auth.example.com/auth/google/callback
